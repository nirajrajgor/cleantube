# Copy to .env and fill in. .env is gitignored.
# Folder holding aapt2, android.jar, d8.jar and apksigner.jar from the Android SDK.
TOOLS=/path/to/android-tools
# Signing key. build.sh creates it on the first build if the file doesn't exist.
KEYSTORE=release.keystore
KEY_ALIAS=cleantube
KEYSTORE_PASS=change-me
